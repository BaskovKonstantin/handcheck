{
  "name": "handcheck",
  "version": "0.5.0",
  "private": true,
  "description": "HandCheck — skills-first IT hiring (FSP special track)",
  "main": "app/server.js",
  "scripts": {
    "start": "node app/server.js",
    "dev": "node --watch app/server.js",
    "test": "node --test test/*.test.js",
    "validate:assessment": "node scripts/validate-assessment.js",
    "validate:matching": "node scripts/validate-matching.js",
    "validate:privacy": "node scripts/validate-privacy.js",
    "validate": "npm run validate:assessment && npm run validate:matching && npm run validate:privacy && node scripts/check-public-template-escape.js",
    "test:browser": "RUN_BROWSER=1 node --test test/cabinet-browser.test.js && node --test scripts/browser-integrations.test.js"
  },
  "bin": {
    "handcheck-mcp": "./bin/handcheck-mcp.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "ws": "^8.18.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "supertest": "^7.1.0"
  }
}
