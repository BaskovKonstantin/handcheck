#!/usr/bin/env bash
set -euo pipefail

LOG_RMI="${FAKE_DOCKER_RMI_LOG:-}"
COMPOSE_DIR="${HANDCHECK_COMPOSE_DIR:-}"
CURRENT_FULL="${FAKE_DOCKER_CURRENT_ID:-sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc}"
PREV_SHORT="${FAKE_DOCKER_PREV_ID:-bbbbbbbbbbbb}"
CURRENT_SHORT="${FAKE_DOCKER_CURRENT_SHORT:-${CURRENT_FULL:7:12}}"
OLD_SHORT="${FAKE_DOCKER_OLD_ID:-aaaaaaaaaaaa}"

case "${1:-}" in
  info)
    if [[ "${2:-}" == "-f" && "${3:-}" == "{{.DockerRootDir}}" ]]; then
      echo /var/lib/docker
      exit 0
    fi
    ;;
  system)
    if [[ "${2:-}" == "df" ]]; then
      echo "TYPE TOTAL ACTIVE SIZE RECLAIMABLE"
      exit 0
    fi
    ;;
  image)
    if [[ "${2:-}" == "inspect" ]]; then
      if [[ "${3:-}" == "handcheck-web:latest" || "${3:-}" == "handcheck-web:previous" ]]; then
        exit 0
      fi
      exit 1
    fi
    if [[ "${2:-}" == "prune" ]]; then
      if [[ -n "${FAKE_DOCKER_PRUNE_LOG:-}" ]]; then
        echo "image-prune" >>"${FAKE_DOCKER_PRUNE_LOG}"
      fi
      exit 0
    fi
    ;;
  builder)
    if [[ "${3:-}" == "prune" ]]; then
      exit 0
    fi
    ;;
  tag)
    exit 0
    ;;
  compose)
    if [[ "${2:-}" == "images" && "${3:-}" == "-q" && "${4:-}" == "web" ]]; then
      echo "$CURRENT_FULL"
      exit 0
    fi
    ;;
  images)
    if [[ "${2:-}" == "handcheck-web:previous" && "${3:-}" == "-q" ]]; then
      echo "$PREV_SHORT"
      exit 0
    fi
    if [[ "${2:-}" == "--format" ]]; then
      echo "${PREV_SHORT} handcheck-web:previous"
      echo "${CURRENT_SHORT} handcheck-web:latest"
      echo "${OLD_SHORT} handcheck-web"
      exit 0
    fi
    if [[ "${2:-}" == "rmi" ]]; then
      if [[ -n "$LOG_RMI" ]]; then
        echo "$2" >>"$LOG_RMI"
      fi
      exit 0
    fi
    ;;
  rmi)
    if [[ -n "$LOG_RMI" ]]; then
      echo "$*" >>"$LOG_RMI"
    fi
    exit 0
    ;;
esac

if [[ -x /usr/bin/docker ]]; then
  exec /usr/bin/docker "$@"
fi
echo "fake-docker: unhandled: $*" >&2
exit 1
